root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
trim_trailing_whitespace = true

[*.{fs,fsi,fsx}]
indent_size = 4

max_line_length = 130

fsharp_max_if_then_short_width = 80
fsharp_max_if_then_else_short_width = 100

fsharp_experimental_keep_indent_in_branch = true

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.ps1]
charset = utf-8
indent_size = 4
