<Project Sdk="Microsoft.NET.Sdk">

  <!-- All six games in one program, which is what a clone of this repository runs.

       Each game is its own executable now - `src/Games/Turncoats` builds `Turncoats`, and
       so on down - and this is the seventh, the one that offers a list and asks which. It is
       here rather than gone because a repository is not a release: every line in the README
       is a `dotnet run` from this directory, and somebody reading it wants every game without
       publishing six files first.

       It owns two files and nothing else, and the two are the whole difference between a
       program with one game in it and a program with six: the list, and the screen that
       asks. Everything either of them does is `Play`'s, shared with the six doors that do
       not have to ask. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <WarningLevel>5</WarningLevel>
  </PropertyGroup>

  <ItemGroup Label="The only file in the program that names more than one game">
    <Compile Include="src/Games.fs" />
  </ItemGroup>

  <ItemGroup Label="The way in - the screen before there is a game">
    <Compile Include="src/Program.fs" />
  </ItemGroup>

  <ItemGroup Label="The engine, and the games it can open">
    <ProjectReference Include="src/TCModel.Engine.fsproj" />
    <ProjectReference Include="src/Games/Turncoats/Turncoats.fsproj" />
    <ProjectReference Include="src/Games/TicTacToe/TicTacToe.fsproj" />
    <ProjectReference Include="src/Games/Diplomacy/Diplomacy.fsproj" />
    <ProjectReference Include="src/Games/Compile/Compile.fsproj" />
    <ProjectReference Include="src/Games/Life/Life.fsproj" />
    <ProjectReference Include="src/Games/Snake/Snake.fsproj" />
  </ItemGroup>

</Project>
