<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <WarningLevel>5</WarningLevel>
  </PropertyGroup>

  <ItemGroup Label="Common - generic, knows nothing of the game">
    <Compile Include="src/Common/Result.fs" />
    <Compile Include="src/Common/Cascade.fs" />
    <Compile Include="src/Common/Random.fs" />
  </ItemGroup>

  <!-- Engine - what every turn-based game wants and none of them should write again: a
       history to walk, a record that replays, seats, a machine to play one of them. It is
       compiled *before* the game and mentions nothing in it; `Rules` is the whole seam, and
       everything here is generic over what a move is, where a game stands, and what it says. -->
  <ItemGroup Label="Engine - the game-shaped hole, and everything that fits round it">
    <Compile Include="src/Engine/Seats.fs" />
    <Compile Include="src/Engine/Messages.fs" />
    <Compile Include="src/Engine/Told.fs" />
    <Compile Include="src/Engine/Rules.fs" />
    <Compile Include="src/Engine/Timeline.fs" />
    <Compile Include="src/Engine/Journal.fs" />
    <Compile Include="src/Engine/Model.fs" />
    <Compile Include="src/Engine/Update.fs" />
    <!-- A seat played by something that is not a person, and after `Update` because taking a
         turn is making a move like anybody else's. Every table that seats one - a keyboard,
         or a network - lets them play through this one loop. -->
    <Compile Include="src/Engine/Machines.fs" />
  </ItemGroup>

  <ItemGroup Label="Domain - the language and rules of the game">
    <Compile Include="src/Domain/Stones.fs" />
    <Compile Include="src/Domain/Board.fs" />
    <Compile Include="src/Domain/Players.fs" />
    <Compile Include="src/Domain/Position.fs" />
    <Compile Include="src/Domain/Ruling.fs" />
    <Compile Include="src/Domain/Game.fs" />
    <Compile Include="src/Domain/Knowledge.fs" />
    <Compile Include="src/Domain/Events.fs" />
    <Compile Include="src/Domain/Actions.fs" />
    <Compile Include="src/Domain/Outcome.fs" />
    <Compile Include="src/Domain/Setup.fs" />
    <!-- Where a game stands and how a turn flows, which is this game's and not the engine's:
         a turn that stays open until a stone goes back is nobody else's rule. -->
    <Compile Include="src/Domain/Turn.fs" />
    <!-- And the seam itself, filled in: this game as the engine takes one. -->
    <Compile Include="src/Domain/Playing.fs" />
    <Compile Include="src/Domain/Rival.fs" />
  </ItemGroup>

  <ItemGroup Label="Console - the only part that talks to a person">
    <Compile Include="src/Console/Waiting.fs" />
    <Compile Include="src/Console/Showing.fs" />
    <Compile Include="src/Console/Words.fs" />
    <Compile Include="src/Console/Render.fs" />
    <Compile Include="src/Console/Parse.fs" />
    <!-- Beside `Parse`, and for the same reason: one reads a line, the other a key. -->
    <Compile Include="src/Console/Keys.fs" />
    <!-- Who is going to be at each seat, which is the one thing every way of opening a game
         has to settle. Above the menu and the command line, because both of them ask it. -->
    <Compile Include="src/Console/Seating.fs" />
    <!-- And the other thing every way of opening a table settles: how far it can be reached
         and what it takes to sit down at one. Before the page and the command line, because
         both of them say it - a browser is handed the word at the door in an address. -->
    <Compile Include="src/Console/Reach.fs" />
    <Compile Include="src/Console/Palette.fs" />
    <Compile Include="src/Console/Tint.fs" />
    <Compile Include="src/Console/Rich.fs" />
    <Compile Include="src/Console/Html.fs" />
    <Compile Include="src/Console/View.fs" />
    <!-- The other half of `Keys`: the half that touches a terminal. Above `View` because a
         screen is drawn through the same view that draws the board, and no higher, because
         nothing about driving one has anything to do with what is being chosen. -->
    <Compile Include="src/Console/Screens.fs" />
    <Compile Include="src/Console/Solo.fs" />
    <Compile Include="src/Console/Options.fs" />
    <!-- The command line, both ways round: what can be asked for, what a typed line comes
         to, and the line the program writes when it has to tell somebody what to type. -->
    <Compile Include="src/Console/Launch.fs" />
    <Compile Include="src/Console/Menu.fs" />
    <Compile Include="src/Console/Transcript.fs" />
  </ItemGroup>

  <ItemGroup Label="Net - the same game, with the players at different keyboards">
    <Compile Include="src/Net/Protocol.fs" />
    <!-- Before the lobby, and not after it, because it does not know there is one. -->
    <Compile Include="src/Net/Browser.fs" />
    <Compile Include="src/Net/Lobby.fs" />
    <Compile Include="src/Net/Server.fs" />
    <Compile Include="src/Net/Client.fs" />
  </ItemGroup>

  <ItemGroup Label="The way in - compiled last, because it needs every layer above it">
    <Compile Include="src/Program.fs" />
  </ItemGroup>

  <ItemGroup Label="The browser's own client, carried rather than fetched">
    <!-- Datastar's client, committed as it was published. A table opened on a machine with
         no way out to the internet is exactly the table this game is for, so the browser
         is handed the script by the same process that is hosting the game. -->
    <EmbeddedResource Include="assets/datastar.js" LogicalName="datastar.js" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Argu" Version="6.2.5" />
    <PackageReference Include="Falco.Datastar" Version="1.3.0" />
    <PackageReference Include="Falco.Markup" Version="1.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <PackageReference Include="Spectre.Console" Version="0.51.1" />
  </ItemGroup>

</Project>
