<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <WarningLevel>5</WarningLevel>
  </PropertyGroup>

  <!-- The order below is the architecture, and the only thing enforcing it. F# compiles a
       project in the order its files are listed, so a layer cannot reach into one beneath it
       on this list even by accident. Read top to bottom: nothing generic mentions a game,
       and the games never mention each other. -->

  <ItemGroup Label="Common - generic, knows nothing of any game">
    <Compile Include="src/Common/Result.fs" />
    <Compile Include="src/Common/Cascade.fs" />
    <Compile Include="src/Common/Random.fs" />
  </ItemGroup>

  <!-- Engine - what every turn-based game wants and none of them should write again: a
       history to walk, a record that replays, seats, a machine to play one of them. `Rules`
       is the whole seam, and everything here is generic over what a move is, where a game
       stands, and what it says. -->
  <ItemGroup Label="Engine - how a game is played">
    <Compile Include="src/Engine/Seats.fs" />
    <Compile Include="src/Engine/Messages.fs" />
    <Compile Include="src/Engine/Told.fs" />
    <Compile Include="src/Engine/Rules.fs" />
    <Compile Include="src/Engine/Timeline.fs" />
    <Compile Include="src/Engine/Journal.fs" />
    <Compile Include="src/Engine/Model.fs" />
    <Compile Include="src/Engine/Update.fs" />
    <!-- A seat played by something that is not a person, and after `Update` because taking a
         turn is making a move like anybody else's. -->
    <Compile Include="src/Engine/Machines.fs" />
  </ItemGroup>

  <!-- Table - how a game is *read*, which is the second seam. `Playable` is to this layer
       what `Rules` is to the engine: fill it in and the timeline, the record, the seats, the
       tokens, the menu, the command line and every screen already work. Nothing here names
       a game, a piece, or a board.

       Two folders and one file between them, and the file is the point: `Parts` is
       everything a game and a table are described in and does not know there is a seam;
       `Playing` is written against it. -->
  <ItemGroup Label="Table - the parts a game and a table are described in">
    <Compile Include="src/Table/Parts/Invoked.fs" />
    <Compile Include="src/Table/Parts/Showing.fs" />
    <Compile Include="src/Table/Parts/Waiting.fs" />
    <Compile Include="src/Table/Parts/Palette.fs" />
    <!-- How far a table can be reached and what it takes to sit down at one. Above the page
         because the door has a page of its own. -->
    <Compile Include="src/Table/Parts/Reach.fs" />
    <!-- One reads a key, the other a line; both before anything that offers a screen. -->
    <Compile Include="src/Table/Parts/Keys.fs" />
    <Compile Include="src/Table/Parts/Commands.fs" />
    <Compile Include="src/Table/Parts/View.fs" />
    <!-- Who is going to be at each seat, which every way of opening a game has to settle. -->
    <Compile Include="src/Table/Parts/Seating.fs" />
    <!-- And the kit those are drawn with: colour over text, the browser's shell, and a
         screen driven at a real terminal. -->
    <Compile Include="src/Table/Parts/Tint.fs" />
    <Compile Include="src/Table/Parts/Page.fs" />
    <Compile Include="src/Table/Parts/Screens.fs" />
    <Compile Include="src/Table/Parts/Options.fs" />
  </ItemGroup>

  <!-- The seam itself. Everything below this line is written against it, and everything
       above it could not name it if it tried. -->
  <ItemGroup Label="Table - the seam">
    <Compile Include="src/Table/Playable.fs" />
  </ItemGroup>

  <ItemGroup Label="Table - playing one, and the two ways in">
    <Compile Include="src/Table/Playing/Solo.fs" />
    <Compile Include="src/Table/Playing/Transcript.fs" />
    <Compile Include="src/Table/Playing/Menu.fs" />
    <Compile Include="src/Table/Playing/Launch.fs" />
  </ItemGroup>

  <ItemGroup Label="Net - the same table, with the players at different keyboards">
    <Compile Include="src/Net/Protocol.fs" />
    <!-- Before the lobby, and not after it, because it does not know there is one. -->
    <Compile Include="src/Net/Browser.fs" />
    <Compile Include="src/Net/Lobby.fs" />
    <Compile Include="src/Net/Server.fs" />
    <Compile Include="src/Net/Client.fs" />
  </ItemGroup>

  <!-- A game is a folder, and inside it the two seams are two folders. `Rules` is how it is
       played: no English, no screen, and nothing from `src/Table` - which is not a house rule
       but a fact you can check, because not one file in there opens it. `Reading` is how it
       is read. `Offer.fs` is the two halves joined, and the only file either layer above ever
       sees. -->
  <ItemGroup Label="Turncoats - how it is played">
    <Compile Include="src/Games/Turncoats/Rules/Stones.fs" />
    <Compile Include="src/Games/Turncoats/Rules/Board.fs" />
    <Compile Include="src/Games/Turncoats/Rules/Players.fs" />
    <Compile Include="src/Games/Turncoats/Rules/Position.fs" />
    <Compile Include="src/Games/Turncoats/Rules/Ruling.fs" />
    <Compile Include="src/Games/Turncoats/Rules/Game.fs" />
    <Compile Include="src/Games/Turncoats/Rules/Knowledge.fs" />
    <Compile Include="src/Games/Turncoats/Rules/Events.fs" />
    <Compile Include="src/Games/Turncoats/Rules/Actions.fs" />
    <Compile Include="src/Games/Turncoats/Rules/Outcome.fs" />
    <Compile Include="src/Games/Turncoats/Rules/Setup.fs" />
    <!-- Where a game stands and how a turn flows, which is this game's and not the engine's:
         a turn that stays open until a stone goes back is nobody else's rule. -->
    <Compile Include="src/Games/Turncoats/Rules/Turn.fs" />
    <Compile Include="src/Games/Turncoats/Rules/Playing.fs" />
    <!-- Words are in here rather than beside the drawings because they are the game talking,
         not a screen: what an event or a refusal *says* is settled once, and the three views
         lay the same sentence out three ways. -->
    <Compile Include="src/Games/Turncoats/Rules/Words.fs" />
    <!-- And a seat played by the program, which reads the game the way a player does and
         draws nothing at all. -->
    <Compile Include="src/Games/Turncoats/Rules/Rival.fs" />
  </ItemGroup>

  <ItemGroup Label="Turncoats - how it is read">
    <Compile Include="src/Games/Turncoats/Reading/Ink.fs" />
    <Compile Include="src/Games/Turncoats/Reading/Parse.fs" />
    <Compile Include="src/Games/Turncoats/Reading/Render.fs" />
    <Compile Include="src/Games/Turncoats/Reading/Rich.fs" />
    <Compile Include="src/Games/Turncoats/Reading/Html.fs" />
    <!-- Both seams filled in: this game as the engine takes one, and as a table reads one. -->
    <Compile Include="src/Games/Turncoats/Offer.fs" />
  </ItemGroup>

  <!-- The second game, and the whole point of the two seams above. Nine squares against a
       map, nothing hidden against a closed bag, no dice against a generator - and the same
       two folders filled in, in the same order, at a fraction of the size. -->
  <ItemGroup Label="Noughts and crosses - how it is played">
    <Compile Include="src/Games/TicTacToe/Rules/Marks.fs" />
    <Compile Include="src/Games/TicTacToe/Rules/Board.fs" />
    <Compile Include="src/Games/TicTacToe/Rules/Session.fs" />
    <Compile Include="src/Games/TicTacToe/Rules/Turn.fs" />
    <Compile Include="src/Games/TicTacToe/Rules/Words.fs" />
    <Compile Include="src/Games/TicTacToe/Rules/Rival.fs" />
  </ItemGroup>

  <ItemGroup Label="Noughts and crosses - how it is read">
    <Compile Include="src/Games/TicTacToe/Reading/Ink.fs" />
    <Compile Include="src/Games/TicTacToe/Reading/Parse.fs" />
    <Compile Include="src/Games/TicTacToe/Reading/Render.fs" />
    <Compile Include="src/Games/TicTacToe/Reading/Rich.fs" />
    <Compile Include="src/Games/TicTacToe/Reading/Html.fs" />
    <Compile Include="src/Games/TicTacToe/Offer.fs" />
  </ItemGroup>

  <!-- What opening a game actually involves - dealing one, keeping its record, the menu,
       the two tables and the browser - generic in the game, and ending in the one interface
       that seals a game's types off so that a list can hold more than one. -->
  <ItemGroup Label="Opening a game">
    <Compile Include="src/Play.fs" />
  </ItemGroup>

  <!-- The only file in the program that names more than one game. -->
  <ItemGroup Label="The games there are">
    <Compile Include="src/Games.fs" />
  </ItemGroup>

  <ItemGroup Label="The way in - compiled last, because it needs every layer above it">
    <Compile Include="src/Program.fs" />
  </ItemGroup>

  <ItemGroup Label="The browser's own client, carried rather than fetched">
    <!-- Datastar's client, committed as it was published. A table opened on a machine with
         no way out to the internet is exactly the table this game is for, so the browser
         is handed the script by the same process that is hosting the game. -->
    <EmbeddedResource Include="assets/datastar.js" LogicalName="datastar.js" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Argu" Version="6.2.5" />
    <PackageReference Include="Falco.Datastar" Version="1.3.0" />
    <PackageReference Include="Falco.Markup" Version="1.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <PackageReference Include="Spectre.Console" Version="0.51.1" />
  </ItemGroup>

</Project>
