<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <WarningLevel>5</WarningLevel>
  </PropertyGroup>

  <ItemGroup Label="Common - generic, knows nothing of the game">
    <Compile Include="src/Common/Result.fs" />
    <Compile Include="src/Common/Cascade.fs" />
    <Compile Include="src/Common/Random.fs" />
  </ItemGroup>

  <ItemGroup Label="Domain - the language and rules of the game">
    <Compile Include="src/Domain/Stones.fs" />
    <Compile Include="src/Domain/Board.fs" />
    <Compile Include="src/Domain/Players.fs" />
    <Compile Include="src/Domain/Position.fs" />
    <Compile Include="src/Domain/Ruling.fs" />
    <Compile Include="src/Domain/Game.fs" />
    <Compile Include="src/Domain/Knowledge.fs" />
    <Compile Include="src/Domain/Events.fs" />
    <Compile Include="src/Domain/Actions.fs" />
    <Compile Include="src/Domain/Outcome.fs" />
    <Compile Include="src/Domain/Setup.fs" />
  </ItemGroup>

  <ItemGroup Label="App - the MVU loop, and the game's memory of itself">
    <Compile Include="src/App/Messages.fs" />
    <Compile Include="src/App/Session.fs" />
    <Compile Include="src/App/Timeline.fs" />
    <Compile Include="src/App/Journal.fs" />
    <Compile Include="src/App/Model.fs" />
    <Compile Include="src/App/Update.fs" />
  </ItemGroup>

  <ItemGroup Label="Console - the only part that talks to a person">
    <Compile Include="src/Console/Waiting.fs" />
    <Compile Include="src/Console/Words.fs" />
    <Compile Include="src/Console/Render.fs" />
    <Compile Include="src/Console/Parse.fs" />
    <Compile Include="src/Console/Palette.fs" />
    <Compile Include="src/Console/Tint.fs" />
    <Compile Include="src/Console/Rich.fs" />
    <Compile Include="src/Console/View.fs" />
    <Compile Include="src/Console/Options.fs" />
    <Compile Include="src/Console/Launch.fs" />
    <Compile Include="src/Console/Shell.fs" />
    <Compile Include="src/Console/Menu.fs" />
    <Compile Include="src/Console/Transcript.fs" />
  </ItemGroup>

  <ItemGroup Label="Net - the same game, with the players at different keyboards">
    <Compile Include="src/Net/Protocol.fs" />
    <Compile Include="src/Net/Lobby.fs" />
    <Compile Include="src/Net/Server.fs" />
    <Compile Include="src/Net/Client.fs" />
  </ItemGroup>

  <ItemGroup Label="The way in">
    <Compile Include="src/Console/Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Argu" Version="6.2.5" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <PackageReference Include="Spectre.Console" Version="0.51.1" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.51.1" />
  </ItemGroup>

</Project>
