<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Diplomacy</AssemblyName>
    <RootNamespace>Prototyping.Diplomacy</RootNamespace>
  </PropertyGroup>

  <ItemGroup Label="How it is played">
    <Compile Include="Rules/Powers.fs" />
    <Compile Include="Rules/Atlas.fs" />
    <Compile Include="Rules/Position.fs" />
    <Compile Include="Rules/Orders.fs" />
    <Compile Include="Rules/Adjudicate.fs" />
    <Compile Include="Rules/Session.fs" />
    <Compile Include="Rules/Turn.fs" />
    <Compile Include="Rules/Words.fs" />
    <Compile Include="Rules/Rival.fs" />
  </ItemGroup>

  <ItemGroup Label="How it is read">
    <Compile Include="Reading/Ink.fs" />
    <Compile Include="Reading/Parse.fs" />
    <Compile Include="Reading/Render.fs" />
    <Compile Include="Offer.fs" />
  </ItemGroup>

  <ItemGroup Label="And the door">
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Play/Prototyping.Play.fsproj" />
  </ItemGroup>

</Project>
