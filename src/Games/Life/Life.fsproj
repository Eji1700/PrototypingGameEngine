<Project Sdk="Microsoft.NET.Sdk">

  <!-- The fifth game, and the one that argues with the other four. They are games in the
       ordinary sense - two or more people, turns in order, somebody wins. This one has a
       single seat, no opponent, nothing to win, and a position that moves because a rule
       says so rather than because anybody chose it.

       It fills in the same two records as the rest, unchanged, and gets the timeline, the
       record on disk, the replay, the seats, the menu, the command line, the wire and all
       three screens without a line of any of them being touched. Which is a better test of
       the two seams than a fifth game of turns and winning would have been. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <WarningLevel>5</WarningLevel>
    <SelfContained>false</SelfContained>
    <AssemblyName>Life</AssemblyName>
    <RootNamespace>TCModel.Life</RootNamespace>
  </PropertyGroup>

  <ItemGroup Label="How it is played">
    <!-- The board and the rule played on it. Four files, of which one is the rule and three
         are what a person does with it. -->
    <Compile Include="Rules/Grid.fs" />
    <Compile Include="Rules/World.fs" />
    <Compile Include="Rules/Turn.fs" />
    <Compile Include="Rules/Words.fs" />
  </ItemGroup>

  <ItemGroup Label="How it is read">
    <!-- Three files, like the other small game: this one describes its screens once as a
         `Scene` and `Readers` draws all three. -->
    <Compile Include="Reading/Ink.fs" />
    <Compile Include="Reading/Parse.fs" />
    <Compile Include="Reading/Render.fs" />
    <Compile Include="Offer.fs" />
  </ItemGroup>

  <ItemGroup Label="And the door">
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../TCModel.Engine.fsproj" />
  </ItemGroup>

</Project>
