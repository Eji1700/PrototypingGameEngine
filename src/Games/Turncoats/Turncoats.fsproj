<Project Sdk="Microsoft.NET.Sdk">


  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <WarningLevel>5</WarningLevel>
    <SelfContained>false</SelfContained>
    <AssemblyName>Turncoats</AssemblyName>
    <RootNamespace>Prototyping.Turncoats</RootNamespace>
  </PropertyGroup>

  <ItemGroup Label="How it is played">
    <Compile Include="Rules/Stones.fs" />
    <Compile Include="Rules/Board.fs" />
    <Compile Include="Rules/Players.fs" />
    <Compile Include="Rules/Position.fs" />
    <Compile Include="Rules/Ruling.fs" />
    <Compile Include="Rules/Game.fs" />
    <Compile Include="Rules/Knowledge.fs" />
    <Compile Include="Rules/Events.fs" />
    <Compile Include="Rules/Actions.fs" />
    <Compile Include="Rules/Outcome.fs" />
    <Compile Include="Rules/Setup.fs" />
    <Compile Include="Rules/Turn.fs" />
    <Compile Include="Rules/Playing.fs" />
    <Compile Include="Rules/Words.fs" />
    <Compile Include="Rules/Rival.fs" />
  </ItemGroup>

  <ItemGroup Label="How it is read">
    <Compile Include="Reading/Ink.fs" />
    <Compile Include="Reading/Parse.fs" />
    <Compile Include="Reading/Render.fs" />
    <Compile Include="Reading/Rich.fs" />
    <Compile Include="Reading/Html.fs" />
    <Compile Include="Offer.fs" />
  </ItemGroup>

  <ItemGroup Label="And the door">
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Play/Prototyping.Play.fsproj" />
  </ItemGroup>

</Project>
