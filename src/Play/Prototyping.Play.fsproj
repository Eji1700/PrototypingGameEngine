<Project Sdk="Microsoft.NET.Sdk">

  <!-- Opening a game: the one call a game's own Program.fs makes, and the composition root that
       ties a keyboard, a menu, a record and a wire together. This is what a game references. -->

  <PropertyGroup>
    <AssemblyName>Prototyping.Play</AssemblyName>
    <RootNamespace>Prototyping</RootNamespace>

    <IsPackable>true</IsPackable>
    <Description>Opening a PrototypingGameEngine game. The one call a game's own Program.fs makes, and the composition root that ties a keyboard, a menu, a record and a wire together.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Play.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Net/Prototyping.Net.fsproj" />
  </ItemGroup>

</Project>
