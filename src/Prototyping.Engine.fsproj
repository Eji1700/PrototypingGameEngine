<Project Sdk="Microsoft.NET.Sdk">

  <!-- The bottom of the stack, and the only part of it a game strictly needs: a fold, a timeline,
       a record and a generator. It has no dependency on anything outside the framework, and the
       three projects above it are what keep it that way - a reach upward from here is now a build
       error rather than a house rule nothing checks. -->

  <PropertyGroup>
    <AssemblyName>Prototyping.Engine</AssemblyName>
    <RootNamespace>Prototyping</RootNamespace>

    <IsPackable>true</IsPackable>
    <Description>The pure core of PrototypingGameEngine: a game dealt from a seed, a fold from a move to the next position, a timeline to walk back through and a record that replays. Depends on FSharp.Core and nothing else.</Description>
  </PropertyGroup>

  <ItemGroup Label="Common - generic, knows nothing of any game">
    <Compile Include="Common/Result.fs" />
    <Compile Include="Common/Tiebreak.fs" />
    <Compile Include="Common/Random.fs" />
    <Compile Include="Common/Counting.fs" />
    <Compile Include="Common/Grid.fs" />
    <Compile Include="Common/Notch.fs" />
  </ItemGroup>

  <ItemGroup Label="Engine - how a game is played">
    <Compile Include="Engine/Seats.fs" />
    <Compile Include="Engine/Messages.fs" />
    <Compile Include="Engine/Told.fs" />
    <Compile Include="Engine/Rules.fs" />
    <Compile Include="Engine/Timeline.fs" />
    <Compile Include="Engine/Journal.fs" />
    <Compile Include="Engine/Model.fs" />
    <Compile Include="Engine/Update.fs" />
    <Compile Include="Engine/Machines.fs" />
  </ItemGroup>

</Project>
