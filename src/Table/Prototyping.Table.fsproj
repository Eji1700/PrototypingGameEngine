<Project Sdk="Microsoft.NET.Sdk">

  <!-- A game described well enough to be read: the seam a game fills in, the screens, the parsing
       of a typed line, the record on disk and the menu. Nothing here listens on a port, and the
       project boundary is what keeps it so - reaching into Net from here is now a build error. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <WarningLevel>5</WarningLevel>
    <AssemblyName>Prototyping.Table</AssemblyName>
    <RootNamespace>Prototyping</RootNamespace>

    <IsPackable>true</IsPackable>
    <Description>A PrototypingGameEngine game described well enough to be read: the seam a game fills in, three ways of drawing a board, the parsing of a typed line, the record on disk and the menu.</Description>
  </PropertyGroup>

  <ItemGroup Label="The parts a game and a table are described in">
    <Compile Include="Parts/Invoked.fs" />
    <Compile Include="Parts/Showing.fs" />
    <Compile Include="Parts/Waiting.fs" />
    <Compile Include="Parts/Scene.fs" />
    <Compile Include="Parts/Palette.fs" />
    <Compile Include="Parts/Settings.fs" />
    <Compile Include="Parts/Reach.fs" />
    <Compile Include="Parts/Keys.fs" />
    <Compile Include="Parts/Commands.fs" />
    <Compile Include="Parts/View.fs" />
    <Compile Include="Parts/Seating.fs" />
    <Compile Include="Parts/Tint.fs" />
    <Compile Include="Parts/Page.fs" />
    <Compile Include="Parts/Screens.fs" />
    <Compile Include="Parts/Options.fs" />
    <Compile Include="Parts/Readers.fs" />
  </ItemGroup>

  <ItemGroup Label="The seam">
    <Compile Include="Playable.fs" />
  </ItemGroup>

  <ItemGroup Label="Playing one, and the two ways in">
    <Compile Include="Playing/Solo.fs" />
    <Compile Include="Playing/Transcript.fs" />
    <Compile Include="Playing/Menu.fs" />
    <Compile Include="Playing/Launch.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Prototyping.Engine.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Argu" Version="6.2.5" />
    <PackageReference Include="Falco.Markup" Version="1.4.0" />
    <PackageReference Include="Falco.Datastar" Version="1.3.0" />
    <PackageReference Include="Spectre.Console" Version="0.51.1" />
  </ItemGroup>

</Project>
